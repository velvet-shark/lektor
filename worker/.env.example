# The Lektor worker — copy to .env and fill in. Never commit real values.

# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Cloudflare R2 (S3-compatible)
CLOUDFLARE_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=lektor
# public base URL for stored objects (r2.dev or custom domain), no trailing slash
R2_PUBLIC_BASE=https://media.example.com

# ElevenLabs (STT + TTS) — used by @lektor/pipeline
ELEVENLABS_API_KEY=sk_...
# Anthropic (translation) — used by @lektor/pipeline
ANTHROPIC_API_KEY=sk-ant-...

# the designed lektor voice
LEKTOR_VOICE_ID=your-elevenlabs-voice-id
# optional TTS model override (default eleven_v3)
# TTS_MODEL=eleven_multilingual_v2

# worker tuning (optional)
# POLL_INTERVAL_MS=3000
# MAX_CONCURRENT_JOBS=3
# PORT=8080
